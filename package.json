{
  "name": "blog-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IA3001's Blog（Astro）编辑 Web 项目：文章管理 + Qwen 题面提取 + 图片粘贴 + 构建校验与推送发布",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "api": "node server/index.js",
    "test:ui": "node tests/ui-smoke.mjs",
    "test:fm": "node tests/frontmatter-probe.mjs",
    "test:plan": "node tests/publish-plan.mjs",
    "test:publish": "node tests/publish-e2e.mjs",
    "test:fs": "node tests/fs-ops.mjs",
    "test:fsui": "node tests/fs-ui.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.2",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.28.4",
    "@neilsustc/markdown-it-katex": "^1.0.0",
    "express": "^4.21.0",
    "highlight.js": "^11.10.0",
    "js-yaml": "^4.1.0",
    "katex": "^0.16.11",
    "markdown-it": "^13.0.2",
    "markdown-it-task-lists": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "trash": "^10.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "puppeteer-core": "^25.7.0",
    "vite": "^5.4.8"
  }
}
